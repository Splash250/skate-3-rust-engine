{
  "format": 1,
  "api": 1,
  "id": "rp-pizza",
  "version": "1.0.0",
  "language": "lua",
  "server_scripts": ["server.lua"],
  "client_scripts": ["client.lua"],
  "files": ["index.html", "pizza.css", "pizza.js"],
  "dependencies": {
    "platform-profiles": "1.0.0",
    "rp-economy": "1.0.0",
    "voice-room": "1.0.0",
    "boardwalk-borough": "1.0.0",
    "phone": "1.0.0"
  },
  "exports": ["snapshot"],
  "capabilities": [
    "resource.events",
    "resource.exports",
    "resource.network",
    "resource.settings",
    "resource.state",
    "resource.storage",
    "engine.ui",
    "resource.teleport"
  ],
  "settings": {
    "delivery_reward": {"type":"integer","default":30,"min":1,"max":100000,"visibility":"private","change":"restart"},
    "minimum_delivery_seconds": {"type":"number","default":5,"min":1,"max":600,"visibility":"private","change":"live"},
    "shift_timeout_seconds": {"type":"integer","default":1800,"min":60,"max":86400,"visibility":"private","change":"live"}
  },
  "requires_features": ["resource.settings.v1", "resource.interfaces.v1", "browser.surface.v1"]
}
