{
  "format": 1,
  "api": 1,
  "id": "voice-room",
  "version": "1.0.0",
  "language": "lua",
  "client_scripts": ["client.lua"],
  "server_scripts": ["server.lua"],
  "exports": ["dispatch_member"],
  "capabilities": ["resource.voice", "engine.voice", "resource.commands", "resource.network", "resource.events", "resource.exports", "resource.settings"],
  "settings": {
    "proximity_meters": {
      "type": "integer",
      "default": 12,
      "min": 1,
      "max": 100,
      "visibility": "private",
      "change": "live"
    }
  },
  "requires_features": ["resource.settings.v1"]
}
